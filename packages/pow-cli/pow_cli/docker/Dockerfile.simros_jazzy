# ──────────────────────────────────────────────────────────────────────────────
# pow_simros Dockerfile – ROS 2 Jazzy
#
# Builds a ROS 2 Jazzy workspace image for Isaac Sim following steps 2-6 of:
#   https://docs.isaacsim.omniverse.nvidia.com/5.1.0/installation/install_ros.html
#       #running-ros-in-docker-containers
#
# Usage:
#   NOTE: `pow` builds and runs these images automatically (`pow init` /
#   `pow ros`). The commands below are the equivalent manual invocations.
#
#   # Build (CUDA_VERSION selects the matching PyTorch wheel index):
#   docker build \
#     -f Dockerfile.simros_jazzy \
#     -t pow_simros_jazzy \
#     --build-context ros_ws=~/.pow/sim-ros/IsaacSim-ros_workspaces/jazzy_ws \
#     --build-arg CUDA_VERSION=12.1 \
#     .
#
#   # Run (HOST_UID/HOST_GID map the container user to the host user):
#   docker run -it --rm --net=host \
#     --env="HOST_UID=$(id -u)" --env="HOST_GID=$(id -g)" \
#     --env="DISPLAY" --env="ROS_DOMAIN_ID" \
#     -v ~/.pow/sim-ros/IsaacSim-ros_workspaces/jazzy_ws:/jazzy_ws \
#     --name pow_simros_jazzy pow_simros_jazzy /bin/bash
# ──────────────────────────────────────────────────────────────────────────────

# ── Step 1: Base ROS 2 desktop image ─────────────────────────────────────────
FROM osrf/ros:jazzy-desktop

ENV ROS_DISTRO=jazzy

# Ubuntu 24.04 base images ship a default 'ubuntu' user with UID/GID 1000,
# which collides with the typical host UID mapped in at runtime: the
# entrypoint would then reuse 'ubuntu' (HOME=/home/ubuntu) while the host
# ~/.ros volume is mounted at /home/hostuser/.ros.  Remove it so the
# entrypoint always creates 'hostuser' with the mapped host UID and all
# /home/hostuser mounts line up.
RUN userdel -r ubuntu 2>/dev/null || true

# ── Step 2: FastDDS configuration ────────────────────────────────────────────
# If the user has a custom ~/.ros/fastdds.xml on the host, they can mount it
# at build time via:
#   --build-arg FASTDDS_XML_PATH=<path-to-fastdds.xml>
# Otherwise, a default fastdds.xml enabling UDP transport is embedded.
RUN mkdir -p /ros_config

# Embed default FastDDS XML for UDP transport (used when no user/workspace
# fastdds.xml is available).
RUN cat > /ros_config/fastdds_default.xml <<'XMLEOF'
<?xml version="1.0" encoding="UTF-8" ?>
<license>Copyright (c) 2022-2024, NVIDIA CORPORATION.  All rights reserved.
NVIDIA CORPORATION and its licensors retain all intellectual property
and proprietary rights in and to this software, related documentation
and any modifications thereto.  Any use, reproduction, disclosure or
distribution of this software and related documentation without an express
license agreement from NVIDIA CORPORATION is strictly prohibited.</license>

<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles" >
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>UdpTransport</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="udp_transport_profile" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>UdpTransport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
XMLEOF

# ── Step 3: Install build tools & packages ──────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-pip \
    ros-jazzy-vision-msgs \
    ros-jazzy-ackermann-msgs \
    ros-jazzy-ros-testing \
    sudo \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Allow passwordless sudo for any user (the container runs as the host
# UID/GID via -u, so /etc/shadow is unavailable and password-based sudo
# always fails).
RUN echo 'ALL ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/allow-all \
    && chmod 0440 /etc/sudoers.d/allow-all

# Make sure rosdep is initialized
RUN rosdep update || true

# ── Install PyTorch (CUDA-aware) ─────────────────────────────────────────
# The host CUDA version is passed in at build time so we pick the matching
# PyTorch wheel index.  Example: CUDA_VERSION=12.8 → cu128
ARG CUDA_VERSION=12.1
RUN CUDA_TAG="cu$(echo ${CUDA_VERSION} | tr -d '.')" && \
    pip3 install --no-cache-dir --break-system-packages \
    torch torchvision torchaudio \
    --index-url "https://download.pytorch.org/whl/${CUDA_TAG}"


# ── Step 4: Default working directory ────────────────────────────────────────
WORKDIR /jazzy_ws

# ── Step 5: Clone additional ROS packages ────────────────────────────────────
# Cloned into /opt/pow/extra_src (NOT /jazzy_ws — that path is shadowed by the
# ros_ws bind mount at build time and by the host volume mount at runtime).
# The entrypoint copies them into /jazzy_ws/src at container start when absent:
# - topic_based_ros2_control: source-only dependency of isaac_moveit (no
#   ros-jazzy-topic-based-ros2-control apt binary is published).
# moveit_resources is NOT cloned: its packages (e.g.
# moveit_resources_panda_moveit_config) are installed from the official apt
# binaries via rosdep in Step 6.
RUN mkdir -p /opt/pow/extra_src && \
    git clone --depth 1 \
        https://github.com/PickNikRobotics/topic_based_ros2_control.git \
        /opt/pow/extra_src/topic_based_ros2_control

# ── Step 6: Install workspace dependencies at image build time ───────────────
# Uses a named build context 'ros_ws' pointing to the <distro>_ws folder.
# /opt/pow/extra_src is included so keys like topic_based_ros2_control resolve
# via --ignore-src and their own dependencies get installed.
# Build with:
#   docker build --build-context ros_ws=~/.pow/sim-ros/IsaacSim-ros_workspaces/jazzy_ws ...
RUN --mount=type=bind,from=ros_ws,target=/jazzy_ws \
    bash -c "\
    source /opt/ros/jazzy/setup.sh && \
    cd /jazzy_ws && \
    apt-get update && \
    rosdep install --from-paths src /opt/pow/extra_src --ignore-src --rosdistro=jazzy -y -r \
    "

# ── Interactive shell environment ────────────────────────────────────────────
# The entrypoint sources ROS before exec'ing the command, which carries the
# environment variables over — but bash completion functions (ros2/colcon
# argcomplete) are shell state and do not survive exec.  Source the setup
# files again in /etc/bash.bashrc so every interactive shell (any user,
# including `docker exec` attaches) gets tab completion.
RUN cat >> /etc/bash.bashrc <<'BASHRCEOF'

# ── pow_simros: ROS 2 environment for interactive shells ──
if [ -f /opt/ros/jazzy/setup.bash ]; then
    source /opt/ros/jazzy/setup.bash
fi
if [ -f /jazzy_ws/install/setup.bash ]; then
    source /jazzy_ws/install/setup.bash
fi
BASHRCEOF

# ── Entrypoint ───────────────────────────────────────────────────────────────
# Resolves FastDDS config (user mount > workspace copy > embedded default),
# sources ROS 2 and the workspace overlay when available.
RUN cat > /ros_config/entrypoint.sh <<'ENTRYEOF'
#!/bin/bash
set -e

# ── Create user entry for the mapped host UID/GID ─────────────────────────
# When the container is started with -u UID:GID the numeric IDs may not
# exist in /etc/passwd or /etc/group, causing "I have no name!" prompts
# and sudo failures.  We create the entries on the fly.

if [ -n "$HOST_UID" ] && [ -n "$HOST_GID" ]; then
    getent group $HOST_GID >/dev/null || groupadd -f -g $HOST_GID hostgroup
    
    if ! getent passwd $HOST_UID >/dev/null; then
        useradd -M -u $HOST_UID -g $HOST_GID -G sudo -d /home/hostuser -s /bin/bash hostuser
        echo "hostuser ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/hostuser
        chmod 0440 /etc/sudoers.d/hostuser
    fi

    # Ensure /home/hostuser exists with correct ownership
    mkdir -p /home/hostuser
    chown $HOST_UID:$HOST_GID /home/hostuser
    
    # Set target user and fix HOME variable
    TARGET_USER=$(getent passwd $HOST_UID | cut -d: -f1)
    export HOME=$(getent passwd $HOST_UID | cut -d: -f6)
else
    TARGET_USER="root"
fi

# ── Seed the per-user rosdep cache ────────────────────────────────────────
# `rosdep update` ran as root at image build time (cache in /root/.ros).
# The container drops to the mapped host user whose HOME starts empty, so
# rosdep would error with "your rosdep installation has not been
# initialized".  Copy the root cache once; when the host ~/.ros is volume-
# mounted the seed persists across containers.
if [ ! -d "$HOME/.ros/rosdep" ] && [ -d /root/.ros/rosdep ]; then
    mkdir -p "$HOME/.ros"
    cp -r /root/.ros/rosdep "$HOME/.ros/rosdep"
    if [ -n "$HOST_UID" ] && [ -n "$HOST_GID" ]; then
        # Own the parent .ros dir too — this script runs as root, and ROS 2
        # logging needs to create $HOME/.ros/log as the runtime user.
        chown "$HOST_UID:$HOST_GID" "$HOME/.ros"
        chown -R "$HOST_UID:$HOST_GID" "$HOME/.ros/rosdep"
    fi
fi

# ROS 2 logging writes to $HOME/.ros/log; make sure the runtime user can.
if [ -n "$HOST_UID" ] && [ -n "$HOST_GID" ] && [ -d "$HOME/.ros" ]; then
    if [ ! -w "$HOME/.ros" ] || [ "$(stat -c %u "$HOME/.ros")" != "$HOST_UID" ]; then
        chown "$HOST_UID:$HOST_GID" "$HOME/.ros"
    fi
    mkdir -p "$HOME/.ros/log"
    chown "$HOST_UID:$HOST_GID" "$HOME/.ros/log"
fi

# ── Seed extra source packages into the workspace ─────────────────────────
# The mounted host workspace may lack source-only packages that were baked
# into the image at /opt/pow/extra_src (see Dockerfile Step 5).  Copy them
# in once; the workspace is a host volume so the seed persists.
_seed_src() {
    # $1 = source dir in /opt/pow/extra_src, $2 = destination dir
    [ -d "$1" ] || return 0
    if [ ! -d "$2" ] || [ -z "$(ls -A "$2" 2>/dev/null)" ]; then
        echo "[pow_simros] Seeding $(basename "$1") into workspace src..."
        rm -rf "$2"
        cp -r "$1" "$2"
        if [ -n "$HOST_UID" ] && [ -n "$HOST_GID" ]; then
            chown -R "$HOST_UID:$HOST_GID" "$2"
        fi
    fi
}
if [ -d /jazzy_ws/src ]; then
    _seed_src /opt/pow/extra_src/topic_based_ros2_control \
              /jazzy_ws/src/topic_based_ros2_control
fi

# ── FastDDS configuration resolution ──────────────────────────────────────
# Priority: 1) user-mounted ~/.ros/fastdds.xml  2) workspace fastdds.xml
#           3) embedded default
if [ -f "$HOME/.ros/fastdds.xml" ]; then
    export FASTRTPS_DEFAULT_PROFILES_FILE="$HOME/.ros/fastdds.xml"
elif [ -f "/jazzy_ws/fastdds.xml" ]; then
    export FASTRTPS_DEFAULT_PROFILES_FILE="/jazzy_ws/fastdds.xml"
else
    export FASTRTPS_DEFAULT_PROFILES_FILE="/ros_config/fastdds_default.xml"
fi

# ── Source ROS 2 base ─────────────────────────────────────────────────────
source /opt/ros/jazzy/setup.bash

# ── Clean stale colcon build artifacts ────────────────────────────────────
# When the workspace volume was previously built at a different path
# (e.g., on the host machine), colcon prefix scripts contain hardcoded
# paths that don't exist in this container.  Detect and clean so the
# next colcon build starts fresh.
if [ -d "/jazzy_ws/build" ]; then
    _stale=""
    for _pf in /jazzy_ws/build/*/colcon_command_prefix_build.sh; do
        [ -f "$_pf" ] || continue
        # Extract the first quoted absolute path from the prefix script
        _ref=$(grep -oP '"\K/[^"]+' "$_pf" 2>/dev/null | head -1)
        if [ -n "$_ref" ] && [ ! -e "$_ref" ]; then
            _stale="$_ref"
            break
        fi
    done
    if [ -n "$_stale" ]; then
        echo "[pow_simros] Stale build artifacts detected (references missing path: $_stale)."
        echo "[pow_simros] Cleaning build/, install/, and log/ for a fresh build..."
        rm -rf /jazzy_ws/build /jazzy_ws/install /jazzy_ws/log
    fi
fi

# ── 4. Source pre-built workspace overlay ─────────────────────────────────
if [ -f "/jazzy_ws/install/setup.bash" ]; then
    source "/jazzy_ws/install/setup.bash"
else
    cd /jazzy_ws
    # If we need to build, do it AS the new user so permissions are correct
    gosu $TARGET_USER colcon build
    source install/local_setup.bash
fi

# ── 5. Drop privileges and execute command ────────────────────────────────
# Use gosu to switch from root to the dynamically created user
exec gosu $TARGET_USER "$@"
ENTRYEOF

RUN chmod +x /ros_config/entrypoint.sh

ENTRYPOINT ["/ros_config/entrypoint.sh"]
CMD ["/bin/bash"]
